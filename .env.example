# Telegram API credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
# TG_SESSION may be left empty on initial run to trigger interactive login;
# after login, paste the printed session string here.
TG_SESSION=
# Channel username without or with @ (e.g. basherkella)
TG_CHANNEL=basherkella

# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WordPress REST API credentials (Application Password generated under Users -> Profile)
WP_URL=https://kstnews24.com
WP_USERNAME=
WP_APP_PASSWORD=
# Post status: publish, draft, or pending (can be overridden by --draft flag)
WP_POST_STATUS=publish

# Media sizing & pipeline settings
THUMB_WIDTH=1200
THUMB_HEIGHT=630
BODY_MAX_WIDTH=1200
MAX_VIDEO_MB=50
FIRST_RUN_LIMIT=10